            "cwd": "${workspaceRoot}/firmware/ecat_tsn_gateway",
            "executable": "${command:cmake.launchTargetPath}",
            "configFiles": [
                "D:/Tools/hpm/sdk_env-main/hpm_sdk/boards/openocd/probes/cmsis_dap.cfg",
                "D:/Tools/hpm/sdk_env-main/hpm_sdk/boards/openocd/soc/hpm6e80-single-core.cfg",
                "D:/Tools/hpm/sdk_env-main/hpm_sdk/boards/openocd/boards/hpm6e00evk.cfg",
                "D:/Tools/hpm/sdk_env-main/hpm_sdk/boards/openocd/soc/_speed200.cfg"
            ],
            "searchDir": [
                "D:/Tools/hpm/sdk_env-main/hpm_sdk/boards/openocd"
            ],
            "gdbPath": "D:/Tools/hpm/sdk_env-main/toolchains/rv32imac_zicsr_zifencei_multilib_b_ext-win/bin/riscv32-unknown-elf-gdb.exe",
            "overrideAttachCommands": [
                "monitor adapter speed 500",
                "monitor halt"
