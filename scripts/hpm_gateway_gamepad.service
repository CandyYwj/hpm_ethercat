# Author: BearKing
[Unit]
Description=HPM Gateway event-driven gamepad node (ROS2 Humble / TROS)
After=network-online.target
Wants=network-online.target
# Start after the control node so /gamepad/joy has a live subscriber.
After=hpm_gateway_node.service
# The clone XBOX360 receiver needs xboxdrv to expose /dev/input/js0.
After=rdk_xboxdrv.service
Wants=rdk_xboxdrv.service

[Service]
Type=simple
User=root
Environment=ROS_DOMAIN_ID=42
# Path where hpm_gateway_gamepad.sh is installed (see scripts/README.md).
ExecStart=/usr/local/bin/hpm_gateway_gamepad.sh
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=10
KillMode=control-group
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hpm_gateway_gamepad

[Install]
WantedBy=multi-user.target
